# Copy to .env.local (gitignored) to point `npm run dev` at your own IRIS build.
# Only read in development; packaged builds ignore it. Shell variables take precedence.
# Relative paths resolve from the project root.

# Full path to iris_cli.exe, e.g. a sibling IRIS-Core checkout:
# IRIS_CLI_PATH=../IRIS-Core/build/bin/iris_cli.exe

# Or a directory containing bin/iris_cli.exe and models/:
# IRIS_HOME=C:/path/to/IRIS/build

# Model engines, if they're not under <IRIS_HOME>/models:
# IRIS_MODELS_DIR=C:/path/to/models
